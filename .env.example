# ---- app ----
SWARM_ENV=dev
SWARM_LOG_LEVEL=INFO
SWARM_LOG_JSON=true

# ---- storage ----
# Postgres in production; SQLite needs no daemon for local work.
SWARM_DATABASE_URL=postgresql+asyncpg://swarm:swarm@localhost:5432/swarm
# SWARM_DATABASE_URL=sqlite+aiosqlite:///./support_swarm.db
SWARM_SESSION_URL=redis://localhost:6379/0
# SWARM_SESSION_URL=memory://
SWARM_SESSION_TTL_SECONDS=86400

# ---- orchestration ----
# deterministic = rule-driven reference pipeline, no model calls
# crewai        = hierarchical CrewAI crew for analysis (needs [crewai] extra)
SWARM_ORCHESTRATOR=deterministic
SWARM_RESOLUTION_TIMEOUT_SECONDS=120

# ---- llm (via LiteLLM) ----
SWARM_LLM_ENABLED=false
SWARM_LLM_MODEL_SUPERVISOR=claude-opus-5
SWARM_LLM_MODEL_WORKER=claude-sonnet-5
SWARM_LLM_MODEL_QA=claude-sonnet-5
SWARM_LLM_REDACT_PROMPTS=true
# LiteLLM reads provider credentials from the standard env vars:
# ANTHROPIC_API_KEY=...

# ---- downstream providers ----
# stub = in-process, deterministic, no network. http = real REST calls.
SWARM_PROVIDER_MODE=stub
SWARM_IDENTITY_API_BASE=http://localhost:9101
SWARM_BILLING_API_BASE=http://localhost:9102
SWARM_ENTITLEMENT_API_BASE=http://localhost:9103
SWARM_NOTIFICATION_API_BASE=http://localhost:9104
SWARM_PROVIDER_TOKEN=

# ---- guardrails ----
SWARM_REFUND_AUTO_APPROVE_CENTS=20000
SWARM_REFUND_WINDOW_DAYS=90
SWARM_REFUND_DAILY_TOTAL_CAP_CENTS=200000
SWARM_ALLOW_AUTONOMOUS_FINANCIAL_ACTIONS=true
SWARM_BLOCK_ACTIONS_ON_INJECTION=true

# ---- api auth ----
# format: key:scope|scope,key2:scope
SWARM_API_KEYS=dev-key:agent,dev-admin-key:agent|admin
SWARM_ESCALATION_QUEUE=support-eng-tier2
